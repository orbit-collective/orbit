# Loaded whenever APP_ENV=testing or an artisan command gets --env=testing.
# Everything here is throwaway: the database lives in memory, so even
# `php artisan migrate:fresh --env=testing` can never touch database/database.sqlite.
APP_ENV=testing
APP_KEY=base64:dGVzdGluZy1rZXktZm9yLW9yYml0LXRlc3RzLW9ubHk=
APP_DEBUG=true

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
