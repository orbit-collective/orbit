{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "lint": "oxlint resources/js --fix",
        "format": "oxfmt resources/js",
        "format:check": "oxfmt --check resources/js",
        "knip": "knip --cache",
        "knip:fix": "knip --fix --fix-type exports,types --format --no-exit-code",
        "unused": "oxlint resources/js -A all -D no-unused-vars",
        "unused:fix": "oxlint resources/js -A all -W no-unused-vars --fix-suggestions",
        "unused:fix:dangerous": "oxlint resources/js -A all -W no-unused-vars --fix-dangerously && oxfmt resources/js",
        "cleanup": "npm run unused:fix && npm run knip:fix",
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build",
        "hooks:install": "git config core.hooksPath .githooks",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage --exclude 'resources/js/stories/**'",
        "test:stories": "vitest run resources/js/stories"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^3.11.0",
        "@storybook/addon-a11y": "^10.6.5",
        "@storybook/addon-docs": "^10.6.5",
        "@storybook/react-vite": "^10.6.6",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^5.0.5",
        "autoprefixer": "^10.6.2",
        "concurrently": "^10.0.6",
        "framer-motion": "^14.9.0",
        "jsdom": "^30.1.3",
        "knip": "^6.44.1",
        "laravel-vite-plugin": "^3.2",
        "oxfmt": "^0.77.0",
        "oxlint": "^1.92.0",
        "postcss": "^8.5.32",
        "react": "^19.2.8",
        "react-dom": "^19.3.1",
        "storybook": "^10.6.6",
        "tailwindcss": "^3.2.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/utilities": "^3.2.2",
        "@sentry/react": "^11.10.0",
        "@tiptap/extension-image": "^3.32.2",
        "@tiptap/extension-placeholder": "^3.32.2",
        "@tiptap/extension-table": "^3.32.2",
        "@tiptap/extension-task-item": "^3.32.2",
        "@tiptap/extension-task-list": "^3.32.2",
        "@tiptap/extensions": "^3.32.2",
        "@tiptap/react": "^3.32.2",
        "@tiptap/starter-kit": "^3.32.2",
        "@tiptap/suggestion": "^3.32.2",
        "axios": "^1.21.0",
        "class-variance-authority": "^0.7.1",
        "laravel-echo": "^2.6.3",
        "lucide-react": "^1.67.0",
        "pusher-js": "^8.6.0",
        "react-colorful": "^5.8.1",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.7.0",
        "tailwind-scrollbar": "^4.0.2",
        "tiptap-markdown": "^0.9.0"
    }
}
