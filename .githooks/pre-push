#!/bin/sh
# Blocks a push when a pushed commit contains frontend files that are not
# formatted with oxfmt. It checks a snapshot of the pushed commit's
# resources/js with that commit's own .oxfmtrc.json (the same thing CI checks),
# not the working tree, so uncommitted edits can neither hide nor cause a
# failure. Runs oxfmt from the host's node_modules, or inside the `vite`
# container when dependencies only live there (the Docker setup).
# Enable once per clone with: npm run hooks:install
# Bypass in an emergency with: git push --no-verify

top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1

zero=0000000000000000000000000000000000000000
tmp=
trap '[ -n "$tmp" ] && rm -rf "$tmp"' EXIT

compose="docker compose"
if command -v doppler >/dev/null 2>&1 && doppler configure get project --plain >/dev/null 2>&1; then
    compose="doppler run -- docker compose"
fi

failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue

    # Nothing to check for commits that predate the oxfmt setup.
    git cat-file -e "$local_sha:.oxfmtrc.json" 2>/dev/null </dev/null || continue
    git cat-file -e "$local_sha:resources/js" 2>/dev/null </dev/null || continue

    # The snapshot lives inside the working tree (removed on exit) so it is also
    # visible under /app in the vite container, even in a linked worktree.
    # It must not match a .gitignore rule, or oxfmt would skip its files.
    # node_modules is resolved by walking up from it.
    tmp=$(mktemp -d "$top/.pre-push-oxfmt.XXXXXX") || exit 1
    git archive "$local_sha" resources/js .oxfmtrc.json tailwind.config.js </dev/null | tar -x -C "$tmp" || exit 1

    if [ -x node_modules/.bin/oxfmt ]; then
        (cd "$tmp" && "$top/node_modules/.bin/oxfmt" --check resources/js) </dev/null || failed=1
    elif command -v docker >/dev/null 2>&1; then
        rel=${tmp#"$top"/}
        echo "pre-push: oxfmt not found on the host, checking inside the vite container." >&2
        $compose run --rm -T -w "/app/$rel" vite /app/node_modules/.bin/oxfmt --check resources/js </dev/null || failed=1
    else
        echo "pre-push: oxfmt is not installed on the host and docker is unavailable, skipping format check." >&2
    fi

    rm -rf "$tmp"
    tmp=
done

if [ "$failed" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: the pushed commits contain unformatted files. Run 'npm run format', commit the result and push again." >&2
    exit 1
fi
