APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live updates. `reverb` turns real-time updates on and needs the REVERB_*
# values below; `log` (or leaving them empty) keeps the app on periodic
# reloads. Generate the three secrets with `openssl rand -hex 16`.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis backs the cache, sessions and queues once CACHE_STORE / SESSION_DRIVER /
# QUEUE_CONNECTION are set to `redis`. `redis` is the Docker service name; use
# 127.0.0.1 when running php artisan outside Docker.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (WebSocket server). REVERB_HOST/PORT/SCHEME is where the app
# and queue workers publish events (the `reverb` Docker service on the internal
# network). REVERB_PUBLIC_* is what the browser connects to: localhost:8080 in
# development, your wss:// domain on 443 behind the reverse proxy in production.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
# Comma separated hosts allowed to open a socket (default: the APP_URL host).
# REVERB_ALLOWED_ORIGINS=
# Scale Reverb over several instances through Redis pub/sub.
# REVERB_SCALING_ENABLED=false

# Without Reverb (or while the socket is down) open pages refresh themselves
# every N seconds, visible tabs only. 0 turns it off; minimum 10.
# LIVE_POLL_INTERVAL=30

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN=

NSFW_DETECTION_ENABLED=true
# Host process (composer dev / php artisan serve): reachable via the published port below.
# Running inside Docker (make dev/up): docker-compose.yml overrides this to http://nsfwjs:3333.
NSFW_SERVICE_URL=http://localhost:3333
NSFW_THRESHOLD=0.70
ORBIT_API_URL=https://api.orbit-dev.app
